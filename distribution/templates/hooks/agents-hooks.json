{
  "ai-sop": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File hook-wrapper.ps1 -EventHint PRE_INVOCATION",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File hook-wrapper.ps1 -EventHint PRE_TOOL_USE",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File hook-wrapper.ps1 -EventHint STOP",
        "timeout": 10
      }
    ]
  }
}
