{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ./.cursor/hook-wrapper.ps1 -EventHint SESSION_START",
        "timeout": 15,
        "failClosed": false
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ./.cursor/hook-wrapper.ps1 -EventHint SESSION_END",
        "timeout": 15,
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ./.cursor/hook-wrapper.ps1 -EventHint PRE_TOOL_USE",
        "matcher": ".*",
        "timeout": 15,
        "failClosed": true
      }
    ]
  }
}
