    ],
    "sessionEnd": [
      {
        "type": "command",
        "command": "cmd /c \"if not exist \".\\.cursor\\hook-wrapper.ps1\" (echo {\\\"decision\\\":\\\"ALLOW\\\",\\\"reasonCode\\\":\\\"SOP_DEGRADED_MISSING_WRAPPER\\\"}) else (pwsh -NoProfile -File .\\.cursor\\hook-wrapper.ps1 -EventHint SESSION_END)\"",
        "timeout": 10,
