{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "change-impact.schema.json",
  "title": "Change Impact Analysis Contract",
  "description": "Machine-readable full-lifecycle change impact and invariant contract. Required when AssessRisk hits TYPE_EXTENSION or PUBLIC_ROUTING, or when semantic risk cannot be assessed; not mandatory for greenfield T3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "feature",
    "baseline",
    "changeSetDigest",
    "changedSymbols",
    "entryPoints",
    "upstreamCallers",
    "downstreamEffects",
    "stateReadsWrites",
    "invariants",
    "requiredRegressionCases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{7,64}|(?:rev|r)?[0-9]+)$",
      "description": "Baseline revision or Git Commit SHA against which changes are analyzed"
    },
    "changeSetDigest": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 digest of the current change set or diff"
    },
    "changedSymbols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Class, method, enum or field modified/added"
      }
    },
    "entryPoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Public protocols, Actions, GM commands or scheduled hooks that trigger this change. For type/strategy extensions list every related public entry (QUERY, MUTATE, RESET trigger, COMPENSATE, admin/GM observe), not only the main write protocol."
      }
    },
    "upstreamCallers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "Upstream callers traversing towards the changed symbols"
      }
    },
    "downstreamEffects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/downstreamEffect"
      }
    },
    "stateReadsWrites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stateAccess"
      }
    },
    "behaviorVariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behaviorVariant"
      },
      "description": "New and legacy type/strategy/variant keys and whether each is IDENTICAL_TO_LEGACY, INTENTIONAL_DIFF, or N_A. Machine-required (non-empty) when AssessRisk hits TYPE_EXTENSION or PUBLIC_ROUTING."
    },
    "lifecycleFacets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lifecycleFacet"
      },
      "description": "Per-facet coverage of a type/strategy extension across the existing system's lifecycle. Machine-required to include INIT, QUERY, VALIDATE, MUTATE, PERSIST, RESET, SERIALIZE, and COMPENSATE when AssessRisk hits TYPE_EXTENSION or PUBLIC_ROUTING. Omitting a facet is not allowed; use coverage=N_A with evidence instead."
    },
    "invariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invariant"
      },
      "description": "Must be non-empty when TYPE_EXTENSION or PUBLIC_ROUTING is detected; each INV-* must be referenced by 05_test_coverage.json cases[].invariantIds."
    },
    "legacyPaths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legacyPath"
      },
      "description": "Old dispatch/entry paths whose protected behavior must not regress. Machine-required (non-empty) when TYPE_EXTENSION or PUBLIC_ROUTING is detected."
    },
    "excludedWithReason": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    },
    "requiredRegressionCases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^TC-[A-Z0-9][A-Z0-9_-]*$"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "downstreamEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effectType",
        "targetSystem",
        "persistenceMethod"
      ],
      "properties": {
        "effectType": {
          "enum": [
            "MUTATION",
            "PERSISTENCE",
            "REWARD",
            "DEDUCTION",
            "BROADCAST",
            "EVENT_PUBLISH"
          ]
        },
        "targetSystem": {
          "type": "string",
          "minLength": 1
        },
        "persistenceMethod": {
          "type": "string",
          "description": "E.g., updateAirData, update(player), saveCommonShop"
        },
        "details": {
          "type": "string"
        }
      }
    },
    "stateAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stateKey",
        "operation",
        "persisted"
      ],
      "properties": {
        "stateKey": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "READ",
            "WRITE",
            "RESET",
            "ACCUMULATE"
          ]
        },
        "persisted": {
          "type": "boolean"
        },
        "persistenceTarget": {
          "type": "string"
        }
      }
    },
    "behaviorVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typeKey",
        "relationToLegacy",
        "description"
      ],
      "properties": {
        "typeKey": {
          "type": "string",
          "minLength": 1
        },
        "relationToLegacy": {
          "enum": [
            "IDENTICAL_TO_LEGACY",
            "INTENTIONAL_DIFF",
            "N_A"
          ]
        },
        "description": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "relationToLegacy": {
                "enum": [
                  "N_A",
                  "INTENTIONAL_DIFF"
                ]
              }
            },
            "required": [
              "relationToLegacy"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 16,
                "description": "Required when relationToLegacy is N_A or INTENTIONAL_DIFF. Must name a locatable symbol, not a boilerplate skip."
              }
            }
          }
        }
      ]
    },
    "lifecycleFacet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facetId",
        "coverage",
        "evidence"
      ],
      "properties": {
        "facetId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "Canonical ids for type-extension gates: INIT, QUERY, VALIDATE, MUTATE, PERSIST, RESET, SERIALIZE, COMPENSATE. Additional project-specific facets are allowed."
        },
        "coverage": {
          "enum": [
            "TOUCHED",
            "INHERITED",
            "N_A"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Locatable symbol (Class#method, file path, or typeKey) supporting the coverage verdict. N_A/INHERITED/TOUCHED boilerplate such as 'n/a' or 'main path covers' is rejected by ValidateChangeImpact."
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariantId",
        "statement",
        "violationRisk"
      ],
      "properties": {
        "invariantId": {
          "type": "string",
          "pattern": "^INV-[A-Z0-9][A-Z0-9_-]*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "violationRisk": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "legacyPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pathName",
        "protectedBehavior"
      ],
      "properties": {
        "pathName": {
          "type": "string"
        },
        "protectedBehavior": {
          "type": "string"
        },
        "regressionCaseId": {
          "type": "string",
          "pattern": "^TC-[A-Z0-9][A-Z0-9_-]*$"
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "reason"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
