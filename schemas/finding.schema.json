{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "severity", "status", "title", "scope", "trigger", "impact", "source", "history"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "severity": {"enum": ["P0", "P1", "P2", "P3"]},
    "status": {"enum": ["OPEN", "IN_REVIEW", "CLOSED", "DISMISSED"]},
    "title": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "trigger": {"type": "string", "minLength": 1},
    "impact": {"type": "string", "minLength": 1},
    "source": {"type": "object", "required": ["repository", "revision", "path"], "properties": {"repository": {"type": "string"}, "revision": {"type": "string"}, "path": {"type": "string"}, "line": {"type": "integer", "minimum": 1}, "taskId": {"type": ["string", "null"]}}},
    "repair": {"type": "object", "required": ["feature", "taskId", "commits", "regressionRunIds"], "properties": {"feature": {"type": "string", "minLength": 1}, "taskId": {"type": "string", "minLength": 1}, "commits": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}}, "regressionRunIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "closure": {"type": "object", "required": ["reason", "evidence"], "properties": {"reason": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}, "reviewers": {"type": "array", "items": {"type": "string"}}, "result": {"type": "string"}, "inputDigest": {"type": "string"}, "limits": {"type": "string"}}},
    "history": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["status", "reason"], "properties": {"status": {"enum": ["OPEN", "IN_REVIEW", "CLOSED", "DISMISSED"]}, "reason": {"type": "string", "minLength": 1}}}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "CLOSED"}}}, "then": {"required": ["repair", "closure"]}},
    {"if": {"properties": {"status": {"const": "DISMISSED"}}}, "then": {"required": ["closure"]}}
  ]
}
