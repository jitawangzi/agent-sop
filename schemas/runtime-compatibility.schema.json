{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskSchemaVersions", "readableInputAlgorithms", "inputAlgorithms", "verificationProtocols", "baselineProvenance"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "taskSchemaVersions": { "$ref": "#/$defs/strings" },
    "readableInputAlgorithms": { "$ref": "#/$defs/strings" },
    "inputAlgorithms": {
      "type": "object", "additionalProperties": false, "required": ["unconfigured", "configured"],
      "properties": { "unconfigured": { "type": "string", "minLength": 1 }, "configured": { "type": "string", "minLength": 1 } }
    },
    "verificationProtocols": { "$ref": "#/$defs/strings" },
    "verificationDefinitionBindings": { "$ref": "#/$defs/strings" },
    "baselineProvenance": { "enum": ["TASK_START"] }
  },
  "$defs": { "strings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
}
