{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification-commands.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commands"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "executable",
          "arguments"
        ],
        "properties": {
          "kind": {
            "enum": [
              "compile",
              "test"
            ]
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "batch": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "caseIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "junitReports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "caseMap": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependentRequired": {
          "junitReports": [
            "caseMap"
          ],
          "caseMap": [
            "junitReports"
          ]
        }
      }
    }
  }
}
