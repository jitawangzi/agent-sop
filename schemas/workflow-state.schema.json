{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-state.schema.json",
  "title": "Feature Workflow Approval State",
  "description": "Durable human approval state for requirement and design artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "feature",
    "requirement",
    "design"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "gateMode": {
      "type": "string",
      "enum": [
        "DUAL",
        "DESIGN_ONLY"
      ],
      "default": "DUAL"
    },
    "requirement": {
      "$ref": "#/$defs/approval"
    },
    "design": {
      "$ref": "#/$defs/approval"
    },
    "baseline": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{7,64}|(?:rev|r)?[0-9]+)$",
      "description": "Immutable baseline Git commit SHA (7-64 hex) or SVN revision (e.g. r123456) captured when the feature was initialized"
    },
    "inferredRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "changeSetDigest",
        "triggersHit",
        "minRequiredTier",
        "hasHighRisk",
        "evaluatedAt"
      ],
      "properties": {
        "baseline": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{7,64}|(?:rev|r)?[0-9]+)$"
        },
        "changeSetDigest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "declaredTier": {
          "enum": ["T1", "T2", "T3", "FAST_TRACK"]
        },
        "minRequiredTier": {
          "enum": ["T1", "T2", "T3", "FAST_TRACK"]
        },
        "hasHighRisk": {
          "type": "boolean"
        },
        "triggersHit": {
          "type": "array",
          "items": { "type": "string" }
        },
        "details": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evaluatedAt": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "status",
        "sha256",
        "approvedAt",
        "approvedBy"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "DRAFT",
            "APPROVED"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^$|^[a-fA-F0-9]{64}$"
        },
        "approvedAt": {
          "type": "string"
        },
        "approvedBy": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "DRAFT"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "sha256": {
                "const": ""
              },
              "approvedAt": {
                "const": ""
              },
              "approvedBy": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "APPROVED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "sha256": {
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "approvedAt": {
                "type": "string",
                "format": "date-time",
                "minLength": 1
              },
              "approvedBy": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gateMode": {
            "not": {
              "const": "DESIGN_ONLY"
            }
          },
          "design": {
            "properties": {
              "status": {
                "const": "APPROVED"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "design"
        ]
      },
      "then": {
        "properties": {
          "requirement": {
            "properties": {
              "status": {
                "const": "APPROVED"
              }
            }
          }
        }
      }
    }
  ]
}
