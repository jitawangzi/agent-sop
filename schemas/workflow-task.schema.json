{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "feature",
    "ownerId",
    "tier",
    "objective",
    "status",
    "nextAction",
    "notes",
    "createdAt",
    "updatedAt",
    "requiredCaseIds",
    "verifications"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "ownerId": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        "T1",
        "T2",
        "T3"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ACTIVE",
        "PAUSED",
        "CANCELLED",
        "DONE"
      ]
    },
    "nextAction": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "requiredCaseIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "batch",
          "command",
          "exitCode",
          "executedAt",
          "inputDigest",
          "inputsStable",
          "caseIds"
        ],
        "properties": {
          "kind": {
            "enum": [
              "compile",
              "test"
            ]
          },
          "batch": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exitCode": {
            "type": "integer"
          },
          "executedAt": {
            "type": "string",
            "format": "date-time"
          },
          "inputDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "inputsStable": {
            "type": "boolean"
          },
          "caseIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "context": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "specDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "runId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "outcome": {
            "enum": [
              "RUNNING",
              "PASSED",
              "FAILED",
              "TIMED_OUT",
              "INTERRUPTED"
            ]
          },
          "inputsRef": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "oneOf": [
          {
            "required": [
              "inputs"
            ],
            "not": {
              "required": [
                "inputsRef"
              ]
            }
          },
          {
            "required": [
              "inputsRef"
            ],
            "not": {
              "required": [
                "inputs"
              ]
            }
          }
        ]
      }
    },
    "impactReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactHash",
        "inputDigest",
        "reviewedAt"
      ],
      "properties": {
        "artifactHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "lastRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "reason",
        "forced"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        },
        "forced": {
          "type": "boolean"
        }
      }
    },
    "tierHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "reason",
          "userRequest",
          "changedAt"
        ],
        "properties": {
          "from": {
            "enum": [
              "T1",
              "T2",
              "T3"
            ]
          },
          "to": {
            "enum": [
              "T1",
              "T2",
              "T3"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          },
          "userRequest": {
            "type": "string",
            "pattern": "\\S"
          },
          "changedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "syncReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentation",
        "tests",
        "summary",
        "recordedAt"
      ],
      "properties": {
        "documentation": {
          "enum": [
            "UPDATED",
            "UNCHANGED"
          ]
        },
        "tests": {
          "enum": [
            "UPDATED",
            "UNCHANGED",
            "NOT_APPLICABLE"
          ]
        },
        "summary": {
          "type": "string",
          "pattern": "\\S"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "compile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "recordedAt",
            "inputDigest"
          ],
          "properties": {
            "status": {
              "enum": [
                "REQUIRED",
                "NOT_APPLICABLE"
              ]
            },
            "reason": {
              "type": "string",
              "pattern": "\\S"
            },
            "recordedAt": {
              "type": "string",
              "format": "date-time"
            },
            "inputDigest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "recordedAt",
            "inputDigest"
          ],
          "properties": {
            "status": {
              "enum": [
                "REQUIRED",
                "NOT_APPLICABLE"
              ]
            },
            "reason": {
              "type": "string",
              "pattern": "\\S"
            },
            "recordedAt": {
              "type": "string",
              "format": "date-time"
            },
            "inputDigest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "followUps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "summary",
          "scope",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "kind": {
            "enum": [
              "documentation",
              "test-cases",
              "verification"
            ]
          },
          "summary": {
            "type": "string",
            "pattern": "\\S"
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "PENDING",
              "RESOLVED",
              "NOT_NEEDED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolution": {
            "type": "string",
            "pattern": "\\S"
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolvedByTaskId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "userRequest": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "RESOLVED",
                    "NOT_NEEDED"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "resolution",
                "resolvedAt",
                "resolvedByTaskId"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "NOT_NEEDED"
                }
              }
            },
            "then": {
              "required": [
                "userRequest"
              ]
            }
          }
        ]
      }
    }
  }
}
