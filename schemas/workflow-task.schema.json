{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "feature",
    "ownerId",
    "tier",
    "objective",
    "status",
    "nextAction",
    "notes",
    "createdAt",
    "updatedAt",
    "requiredCaseIds",
    "verifications"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "ownerId": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        "T1",
        "T2",
        "T3"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ACTIVE",
        "PAUSED",
        "CANCELLED",
        "DONE"
      ]
    },
    "nextAction": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "requiredCaseIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "batch",
          "command",
          "exitCode",
          "executedAt",
          "inputDigest",
          "inputsStable",
          "caseIds"
        ],
        "properties": {
          "kind": {
            "enum": [
              "compile",
              "test"
            ]
          },
          "batch": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exitCode": {
            "type": "integer"
          },
          "executedAt": {
            "type": "string",
            "format": "date-time"
          },
          "inputDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "inputsStable": {
            "type": "boolean"
          },
          "caseIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "context": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "specDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "runId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "outcome": {
            "enum": [
              "RUNNING",
              "PASSED",
              "FAILED",
              "TIMED_OUT",
              "INTERRUPTED"
            ]
          },
          "inputsRef": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "diagnostic": {
            "type": "string"
          },
          "reportEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "format",
              "passedCaseIds",
              "reports"
            ],
            "properties": {
              "format": {
                "const": "JUNIT"
              },
              "passedCaseIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "reports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256",
                    "testCount",
                    "failed",
                    "skipped"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "testCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "failed": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "skipped": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "inputs"
            ],
            "not": {
              "required": [
                "inputsRef"
              ]
            }
          },
          {
            "required": [
              "inputsRef"
            ],
            "not": {
              "required": [
                "inputs"
              ]
            }
          }
        ]
      }
    },
    "impactReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactHash",
        "inputDigest",
        "reviewedAt"
      ],
      "properties": {
        "hashAlgorithm": { "const": "sha256-text-lf-v1" },
        "artifactHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "changeSetDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "lastRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "reason",
        "forced"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        },
        "forced": {
          "type": "boolean"
        },
        "quarantinedEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "originalPath",
              "backupPath",
              "sha256",
              "diagnostic",
              "machine",
              "workspace"
            ],
            "properties": {
              "originalPath": {
                "type": "string"
              },
              "backupPath": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "diagnostic": {
                "type": "string"
              },
              "machine": {
                "type": "string"
              },
              "workspace": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "tierSelection": {
      "description": "与任务创建一起记录的初始档位选择。人工原话由调用方提供，仅用于追溯依据，不是独立的人类身份认证；历史任务可缺省此字段。",
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "source", "recordedAt"],
      "properties": {
        "tier": { "enum": ["T1", "T2", "T3"] },
        "source": { "enum": ["DEFAULT", "USER_REQUEST", "LEGACY_PRESERVED"] },
        "recordedAt": { "type": "string", "format": "date-time" },
        "userRequest": { "type": "string", "pattern": "\\S" }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "DEFAULT" } } },
          "then": { "properties": { "tier": { "const": "T2" } } }
        },
        {
          "if": { "properties": { "source": { "const": "USER_REQUEST" } } },
          "then": { "required": ["userRequest"] },
          "else": { "not": { "required": ["userRequest"] } }
        }
      ]
    },
    "tierHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "reason",
          "userRequest",
          "changedAt"
        ],
        "properties": {
          "from": {
            "enum": [
              "T1",
              "T2",
              "T3"
            ]
          },
          "to": {
            "enum": [
              "T1",
              "T2",
              "T3"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          },
          "userRequest": {
            "type": "string",
            "pattern": "\\S"
          },
          "changedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "syncReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentation",
        "tests",
        "summary",
        "recordedAt"
      ],
      "properties": {
        "documentation": {
          "enum": [
            "UPDATED",
            "UNCHANGED"
          ]
        },
        "tests": {
          "enum": [
            "UPDATED",
            "UNCHANGED",
            "NOT_APPLICABLE"
          ]
        },
        "summary": {
          "type": "string",
          "pattern": "\\S"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "compile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "recordedAt",
            "inputDigest"
          ],
          "properties": {
            "status": {
              "enum": [
                "REQUIRED",
                "NOT_APPLICABLE"
              ]
            },
            "reason": {
              "type": "string",
              "pattern": "\\S"
            },
            "recordedAt": {
              "type": "string",
              "format": "date-time"
            },
            "inputDigest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "startInputsRef": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "recordedAt",
            "inputDigest"
          ],
          "properties": {
            "status": {
              "enum": [
                "REQUIRED",
                "NOT_APPLICABLE"
              ]
            },
            "reason": {
              "type": "string",
              "pattern": "\\S"
            },
            "recordedAt": {
              "type": "string",
              "format": "date-time"
            },
            "inputDigest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "startInputsRef": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "followUps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "summary",
          "scope",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "kind": {
            "enum": [
              "documentation",
              "test-cases",
              "verification"
            ]
          },
          "summary": {
            "type": "string",
            "pattern": "\\S"
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "PENDING",
              "RESOLVED",
              "NOT_NEEDED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolution": {
            "type": "string",
            "pattern": "\\S"
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolvedByTaskId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "resolutionHistory": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["status", "resolution", "resolvedAt", "resolvedByTaskId", "reopenedAt", "reopenedByTaskId", "reason"],
              "properties": {
                "status": { "enum": ["RESOLVED", "NOT_NEEDED"] },
                "resolution": { "type": "string", "pattern": "\\S" },
                "resolvedAt": { "type": "string", "format": "date-time" },
                "resolvedByTaskId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" },
                "userRequest": { "type": "string", "pattern": "\\S" },
                "reopenedAt": { "type": "string", "format": "date-time" },
                "reopenedByTaskId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" },
                "reason": { "type": "string", "pattern": "\\S" }
              },
              "allOf": [{"if": {"properties": {"status": {"const": "NOT_NEEDED"}}}, "then": {"required": ["userRequest"]}}]
            }
          },
          "userRequest": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "RESOLVED",
                    "NOT_NEEDED"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "resolution",
                "resolvedAt",
                "resolvedByTaskId"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "NOT_NEEDED"
                }
              }
            },
            "then": {
              "required": [
                "userRequest"
              ]
            }
          }
        ]
      }
    },
    "startImpact": {
      "description": "Optional immutable 04 snapshot at Start. Absent on older tasks; never backfilled on Resume.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["ABSENT", "CAPTURED", "UNAVAILABLE"] },
        "hashAlgorithm": { "const": "sha256-text-lf-v1" },
        "artifactHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "properties": { "status": { "const": "ABSENT" } }, "not": { "anyOf": [{ "required": ["artifactHash"] }, { "required": ["hashAlgorithm"] }, { "required": ["reason"] }] } },
        { "properties": { "status": { "const": "CAPTURED" } }, "required": ["artifactHash"], "not": { "required": ["reason"] } },
        { "properties": { "status": { "const": "UNAVAILABLE" } }, "required": ["reason"], "not": { "anyOf": [{ "required": ["artifactHash"] }, { "required": ["hashAlgorithm"] }] } }
      ]
    },
    "startInputs": {
      "description": "Immutable origin recorded in the task creation transaction, never supplied by Run or SetBaseline.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "taskId",
        "feature",
        "createdAt",
        "transactionId",
        "mode"
      ],
      "properties": {
        "status": {
          "enum": [
            "CAPTURED",
            "UNAVAILABLE"
          ]
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "transactionId": {
          "type": "string",
          "pattern": "^claim-[0-9a-f]{32}$"
        },
        "mode": {
          "enum": [
            "FULL",
            "BOUNDED"
          ]
        },
        "inputsRef": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "CAPTURED"
          }
        }
      },
      "then": {
        "required": [
          "inputsRef",
          "inputDigest"
        ]
      },
      "else": {
        "required": [
          "reason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "inputsRef"
              ]
            },
            {
              "required": [
                "inputDigest"
              ]
            }
          ]
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vcs",
        "revision",
        "capturedAt",
        "source"
      ],
      "properties": {
        "vcs": {
          "enum": [
            "git",
            "svn",
            "none"
          ]
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "enum": [
            "START",
            "ADOPTED"
          ]
        },
        "inputsRef": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "dependentRequired": {
        "inputsRef": [
          "inputDigest"
        ],
        "inputDigest": [
          "inputsRef"
        ]
      }
    },
    "caseScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseIds",
        "reason",
        "specDigest",
        "recordedAt"
      ],
      "properties": {
        "caseIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "specDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "caseScopeHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseIds",
          "reason",
          "specDigest",
          "recordedAt"
        ],
        "properties": {
          "caseIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "specDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
